{
	"description": "InkGlance: answer permission requests and reply to finished sessions from an e-ink reader. Each hook exits at once when the panel is not running.",
	"hooks": {
		"PermissionRequest": [
			{
				"matcher": "*",
				"hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/src/hook.sh\" permission", "timeout": 900 }]
			}
		],
		"Stop": [
			{
				"hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/src/hook.sh\" stop", "timeout": 86520, "asyncRewake": true }]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/src/hook.sh\" prompt", "timeout": 5 }]
			}
		]
	}
}
