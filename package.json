{
	"name": "inkglance",
	"version": "0.1.0",
	"description": "A Claude Code session panel for e-ink readers on your local network.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"inkglance": "src/server.js"
	},
	"scripts": {
		"start": "node src/server.js",
		"test": "node --test",
		"check": "sh scripts/check.sh",
		"service:install": "sh scripts/service-macos.sh install",
		"service:uninstall": "sh scripts/service-macos.sh uninstall",
		"service:status": "sh scripts/service-macos.sh status",
		"service:logs": "sh scripts/service-macos.sh logs",
		"statusline:print": "sh scripts/statusline-snippet.sh",
		"hooks:install": "node scripts/hooks.js install",
		"hooks:uninstall": "node scripts/hooks.js uninstall",
		"hooks:status": "node scripts/hooks.js status",
		"config": "node scripts/config.js",
		"tray:install": "sh scripts/tray-macos.sh install",
		"tray:build": "sh scripts/tray-macos.sh build",
		"tray:dev": "sh scripts/tray-macos.sh dev",
		"demo": "node scripts/demo.js"
	}
}
